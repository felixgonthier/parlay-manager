# Sleeper league id (from https://sleeper.com/leagues/<ID>)
SLEEPER_LEAGUE_ID=1389734249816428544

# Your own admin password (guards /admin only; the pick page is open)
ADMIN_PASSWORD=change-me

# Upstash Redis (Vercel > Storage > Upstash Redis sets these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: weekly lock time. Picks close at this hour (America/New_York) on Sunday.
# Leave unset to never lock.
LOCK_SUNDAY_HOUR_ET=13
